BOT_TOKEN=your_telegram_bot_token_here
GOOGLE_API_KEY=your_google_ai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TARGET_CHANNEL_ID=@your_channel_id_or_number
NEWS_RSS_URLS=https://example.com/feed1.xml,https://example.com/feed2.xml
POST_TEMPLATE="Заголовок: {title}\nКратко: {summary}\nСсылка: {link}"

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aichannel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Admin
ADMIN_USER_IDS=[123456789,987654321]

# App Settings
AUTO_PUBLISH=false
MODERATION=true

# Post style controls
POST_MAX_CHARS=900
POST_MAX_EMOJIS=4

# Images (preferred source)
# IMAGE_SOURCE=search  -> take image from article meta tags; then search twice; then generate
# IMAGE_SOURCE=auto    -> try OpenAI first; then search
# IMAGE_SOURCE=openai  -> OpenAI only
IMAGE_SOURCE=search
IMAGE_SEARCH_MAX_RESULTS=10
IMAGE_SEARCH_SAFESEARCH=moderate
IMAGE_SEARCH_RETRIES=2
IMAGE_SEARCH_RETRY_DELAY_SEC=0.7

# RSS balancing
# How many recent items to pull into the candidate pool (multiplier * CANDIDATES_FOR_LLM)
CANDIDATE_POOL_MULTIPLIER=5
# Default per-source cap when building candidate list
MAX_CANDIDATES_PER_SOURCE=6
# Optional per-source caps in a convenient format:
# SOURCE_CANDIDATE_CAPS=The Verge=4,TechCrunch=4,vc.ru=6,3DNews=6,Habr=3
# (JSON also works) SOURCE_CANDIDATE_CAPS={"The Verge":4,"vc.ru":6}
SOURCE_CANDIDATE_CAPS=
# Cooldown: if a source was published within the last N hours, reduce its cap by PENALTY
SOURCE_COOLDOWN_HOURS=6
SOURCE_COOLDOWN_CAP_PENALTY=2

