BOT_TOKEN=your_telegram_bot_token_here
# Google Gemini API keys
# Single key (backwards compatible):
GOOGLE_API_KEY=your_google_ai_api_key_here
# Multiple keys (rotation on quota/429). Format: comma-separated or JSON list.
# GOOGLE_API_KEYS=key1,key2,key3
# GOOGLE_API_KEYS=["key1","key2","key3"]
GOOGLE_API_KEYS=
OPENAI_API_KEY=your_openai_api_key_here
TARGET_CHANNEL_ID=@your_channel_id_or_number
NEWS_RSS_URLS=https://meduza.io/rss2/all,https://rssexport.rbc.ru/rbcnews/news/30/full.rss,https://www.theverge.com/rss/index.xml,https://www.theverge.com/rss/ai-artificial-intelligence/index.xml,https://www.vox.com/rss/index.xml,https://www.vox.com/rss/culture/index.xml,https://www.bbc.com/culture/feed.rss,https://www.theguardian.com/culture/rss,https://www.theguardian.com/media/rss,https://feeds.arstechnica.com/arstechnica/technology-lab,https://feeds.feedburner.com/TechCrunch/,http://feeds.feedburner.com/VentureBeat,https://www.economist.com/culture/rss.xml,https://www.ft.com/life-arts?format=rss,https://www.reuters.com/technology/rss,https://rss.nytimes.com/services/xml/rss/nyt/Arts.xml,https://www.techmeme.com/feed.xml
POST_TEMPLATE="Заголовок: {title}\nКратко: {summary}\nСсылка: {link}"

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aichannel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Admin
ADMIN_USER_IDS=[123456789,987654321]

# App Settings
# AUTO_PUBLISH=true -> сразу публиковать в канал без ручного подтверждения драфта
# AUTO_PUBLISH=false -> только драфт админу, публикация командой /publish
AUTO_PUBLISH=true
MODERATION=true

# Post style controls
POST_MAX_CHARS=900
POST_MAX_EMOJIS=4

# Images (preferred source)
# IMAGE_SOURCE=search  -> take image from article meta tags; then search twice; then generate
# IMAGE_SOURCE=auto    -> try OpenAI first; then search
# IMAGE_SOURCE=openai  -> OpenAI only
IMAGE_SOURCE=search
IMAGE_SEARCH_MAX_RESULTS=10
IMAGE_SEARCH_SAFESEARCH=moderate
IMAGE_SEARCH_RETRIES=2
IMAGE_SEARCH_RETRY_DELAY_SEC=0.7

# RSS balancing
# How many recent items to pull into the candidate pool (multiplier * CANDIDATES_FOR_LLM)
CANDIDATE_POOL_MULTIPLIER=5
# Default per-source cap when building candidate list
MAX_CANDIDATES_PER_SOURCE=6
# Optional per-source caps in a convenient format:
# Cooldown: if a source was published within the last N hours, reduce its cap by PENALTY
SOURCE_COOLDOWN_HOURS=6
SOURCE_COOLDOWN_CAP_PENALTY=2

